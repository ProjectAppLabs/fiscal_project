# =============================================================================
# Environment
# =============================================================================
DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me-replace-with-strong-secret-min-50-chars
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_LOG_LEVEL=INFO

# =============================================================================
# CORS / CSRF
# =============================================================================
DJANGO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5173

# =============================================================================
# Database
# =============================================================================
# Development: MySQL 8.4 in the fiscal-mysql container (ProjectApp standard).
#   docker run -d --name fiscal-mysql -p 127.0.0.1:3308:3306 -e MYSQL_ROOT_PASSWORD=fiscal-root \
#     -e MYSQL_DATABASE=fiscal -e MYSQL_USER=fiscal -e MYSQL_PASSWORD=fiscal mysql:8.4
DJANGO_DB_ENGINE=django.db.backends.mysql
DB_NAME=fiscal
DB_USER=fiscal
DB_PASSWORD=fiscal
DB_HOST=127.0.0.1
DB_PORT=3308

# Tests use SQLite unless this is set (concurrency tests need MySQL):
# DJANGO_TEST_DB_ENGINE=django.db.backends.mysql
# DJANGO_TEST_DB_NAME=test_fiscal

# =============================================================================
# JWT
# =============================================================================
DJANGO_JWT_ACCESS_MINUTES=15
DJANGO_JWT_REFRESH_DAYS=7

# =============================================================================
# Email SMTP
# =============================================================================
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_DEFAULT_FROM_EMAIL=

# =============================================================================
# Frontend
# =============================================================================
FRONTEND_URL=http://localhost:3000

# =============================================================================
# Redis (for Huey task queue)
# =============================================================================
REDIS_URL=redis://localhost:6380/1

# =============================================================================
# Backups (django-dbbackup)
# =============================================================================
BACKUP_STORAGE_PATH=/var/backups/fiscal_project
# Retention is controlled by DBBACKUP_CLEANUP_KEEP in settings.py (default: 4 weekly backups ≈ 1 month)

# =============================================================================
# Query Profiling (django-silk)
# =============================================================================
ENABLE_SILK=false
# SLOW_QUERY_THRESHOLD_MS=500
# N_PLUS_ONE_THRESHOLD=10

# =============================================================================
# API Keys (project-specific, add as needed)
# =============================================================================
# When both keys are empty, captcha verification is bypassed (development).
# Get keys from: https://www.google.com/recaptcha/admin
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
# PAYMENT_GATEWAY_KEY=replace

# =============================================================================
# Fiscal.
# =============================================================================
# Fernet key that encrypts every secret at rest. Required: the app does not start without it.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it makes every stored certificate and secret unreadable: back it up apart from the database.
FISCAL_ENCRYPTION_KEY=
# simulated (never transmits, refuses production issuers) | soap (real DIAN, F2)
DIAN_GATEWAY=simulated
